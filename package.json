{
  "name": "cati",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/migrate.ts && node scripts/seed.ts",
    "db:reset": "rm -f \"${CAT_DB:-./data/cat.db}\" \"${CAT_DB:-./data/cat.db}-wal\" \"${CAT_DB:-./data/cat.db}-shm\" && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "ci": "bash scripts/ci.sh",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
